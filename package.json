{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:types": "tsx scripts/generate_types.ts",
    "predev": "tsx scripts/generate_types.ts",
    "prebuild": "tsx scripts/generate_types.ts",
    "build": "tsx scripts/generate_types.ts && vite build",
    "build:prod": "tsx scripts/generate_types.ts && vite build",
    "install:extension": "tsx scripts/generate_types.ts && vite build",
    "watch": "vite build --watch",
    "prelint": "tsx scripts/generate_types.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js jupyterlab_bopp/labextension",
    "lint": "tsx scripts/generate_types.ts && tsc --noEmit"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_bopp/labextension"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
