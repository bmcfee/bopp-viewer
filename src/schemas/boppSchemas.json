{
  "annotation.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "annotation.json",
    "title": "Annotation",
    "type": "object",
    "properties": {
      "id": {
        "description": "Unique identifier generated via UUIDv5 based on canonical annotation content",
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-5[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "parents": {
        "description": "List of parent annotation IDs from which this annotation was derived",
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "media_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9]+:.*$"
      },
      "bopp_version": {
        "type": "string",
        "pattern": "^1\\.\\d+$",
        "description": "The Semantic Version of the BOPP schema (e.g., 1.0)"
      },
      "metadata": {
        "description": "The metadata describing the annotation",
        "$ref": "metadata.json"
      },
      "extent": {
        "description": "The parallel array of time/space boundaries (e.g., time_interval, point)",
        "$ref": "extents.json"
      },
      "payload": {
        "description": "The parallel array of values (e.g., beat, chord)",
        "$ref": "payloads.json"
      },
      "confidence": {
        "description": "Optional parallel array of likelihoods or votes",
        "$ref": "confidences.json"
      },
      "sandbox": {
        "description": "Unstructured storage area for arbitrary user-defined data",
        "type": "object"
      },
      "groupings": {
        "description": "Optional array of groupings defined over indices or element IDs",
        "type": "array",
        "items": {
          "$ref": "grouping.json"
        }
      }
    },
    "required": [
      "media_id",
      "payload",
      "bopp_version"
    ]
  },
  "confidence/agreement.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "confidence/agreement.json",
    "title": "Confidence by inter-annotator agreement",
    "type": "object",
    "properties": {
      "confidence_type": {
        "const": "agreement"
      },
      "num_annotators_common": {
        "type": "integer",
        "minimum": 1,
        "description": "The number of annotators who produced all observations"
      },
      "confidence": {
        "$ref": "../core.json#/$defs/Array",
        "description": "The fraction of annotators agreeing on this measurement",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "num_annotators": {
        "$ref": "../core.json#/$defs/Array",
        "description": "The number of annotators who produced each observation",
        "items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "required": [
      "confidence_type",
      "confidence"
    ]
  },
  "confidence/likelihood.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "confidence/likelihood.json",
    "title": "Likelihood Confidence",
    "type": "object",
    "properties": {
      "confidence_type": {
        "const": "likelihood"
      },
      "confidence": {
        "$ref": "../core.json#/$defs/Array",
        "description": "The likelihood (probability) of each observation",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "required": [
      "confidence_type",
      "confidence"
    ]
  },
  "confidence/variance.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "confidence/variance.json",
    "title": "Variance Confidence",
    "type": "object",
    "properties": {
      "confidence_type": {
        "const": "variance"
      },
      "confidence": {
        "$ref": "../core.json#/$defs/Array",
        "description": "The variance of each observation",
        "items": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "required": [
      "confidence_type",
      "confidence"
    ]
  },
  "confidences.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "confidences.json",
    "title": "Any Confidence",
    "description": "A discriminated union of all supported columnar confidence types.",
    "oneOf": [
      {
        "$ref": "confidence/agreement.json"
      },
      {
        "$ref": "confidence/likelihood.json"
      },
      {
        "$ref": "confidence/variance.json"
      }
    ],
    "discriminator": {
      "propertyName": "confidence_type"
    }
  },
  "core.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "core.json",
    "title": "BOPP Core Primitives",
    "$defs": {
      "Array": {
        "type": "array",
        "description": "A dense columnar array buffer."
      },
      "Fraction": {
        "type": "array",
        "description": "Rational number encoded as numerator and non-zero denominator",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "integer",
            "description": "Numerator, signed integer"
          },
          {
            "type": "integer",
            "minimum": 1,
            "description": "Denominator. Strictly positive to prevent zero-division and negative bases."
          }
        ],
        "items": false
      },
      "FractionNonnegative": {
        "type": "array",
        "description": "Non-negative rational number",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "description": "Numerator, non-negative integer"
          },
          {
            "type": "integer",
            "minimum": 1,
            "description": "Denominator. Strictly positive to prevent zero-division and negative bases."
          }
        ],
        "items": false
      }
    }
  },
  "extent/cartesian.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "extent/cartesian.json",
    "title": "Cartesian Extent",
    "description": "3D spatial coordinates in Cartesian space (x, y, z).",
    "type": "object",
    "properties": {
      "extent_type": {
        "const": "cartesian"
      },
      "x": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Array of x-coordinates in space.",
        "items": {
          "type": "number"
        }
      },
      "y": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Array of y-coordinates in space.",
        "items": {
          "type": "number"
        }
      },
      "z": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Array of z-coordinates in space.",
        "items": {
          "type": "number"
        }
      }
    },
    "required": [
      "extent_type",
      "x",
      "y",
      "z"
    ]
  },
  "extent/cartesian_time.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
