    "$id": "extent/spherical.json",
    "title": "Spherical Extent",
    "description": "3D spatial coordinates in spherical coordinates (azimuth, elevation, radius).",
    "type": "object",
    "properties": {
      "extent_type": {
        "const": "spherical"
      },
      "azimuth": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Array of azimuth angles in degrees in [-180, +180).",
        "items": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 180
        }
      },
      "elevation": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Array of elevation angles in degrees in [-90, +90].",
        "items": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "radius": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Array of non-negative radial distances (greater than or equal to 0).",
        "items": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "required": [
      "extent_type",
      "azimuth",
      "elevation",
      "radius"
    ]
  },
