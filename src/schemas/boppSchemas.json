    }
  },
  "payload/beat.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/beat.json",
    "title": "Beat Position Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "beat"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "The metric position of the beat within the measure (e.g., 1 for downbeat, 2, 3, 4).",
        "items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payload/chord.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/chord.json",
    "title": "Chord Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "chord"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "A musical chord string in extended Harte notation.",
        "items": {
          "type": "string",
          "pattern": "^((N|X)|(([A-G]([b♭]*|𝄫|[#♯]*|𝄪|♮))((:(maj|min|dim|aug|1|5|sus2|sus4|maj6|min6|7|maj7|min7|dim7|hdim7|minmaj7|aug7|9|maj9|min9|11|maj11|min11|13|maj13|min13)(\\((\\*?(([b♭]*|𝄫|[#♯]*|𝄪|♮)([1-9]|1[0-3]?))(,\\*?(([b♭]*|𝄫|[#♯]*|𝄪|♮)([1-9]|1[0-3]?)))*)\\))?)|(:\\((\\*?(([b♭]*|𝄫|[#♯]*|𝄪|♮)([1-9]|1[0-3]?))(,\\*?(([b♭]*|𝄫|[#♯]*|𝄪|♮)([1-9]|1[0-3]?)))*)\\)))?((/(([b♭]*|𝄫|[#♯]*|𝄪|♮)([1-9]|1[0-3]?)))?)?))$"
        }
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payload/ext.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/ext.json",
    "title": "Extension Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "ext"
      },
      "ext_schema": {
        "type": "string",
        "format": "uri",
        "description": "Identifier for the schema defining the items in the value array."
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Annotations consisting of structured extension data.",
        "items": {}
      }
    },
    "required": [
      "payload_type",
      "ext_schema",
      "value"
    ]
  },
  "payload/frequency_hz.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/frequency_hz.json",
    "title": "Frequency_Hz Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "frequency_hz"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Frequencies in Hz",
        "items": {
          "type": "number",
          "minimum": 0
        }
      },
      "voiced": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Optional voicing flag indicating whether each observation is voiced",
        "items": {
          "type": "boolean"
        }
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payload/key_mode.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/key_mode.json",
    "title": "Key_Mode Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "key_mode"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Key and optional mode (major/minor or Greek modes)",
        "items": {
          "type": "string",
          "pattern": "^((N)|(([A-G]([b♭]*|𝄫|[#♯]*|𝄪|♮))(:(major|minor|ionian|dorian|phrygian|lydian|mixolydian|aeolian|locrian))?))$"
        }
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payload/lyrics.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/lyrics.json",
    "title": "Lyrics Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "lyrics"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Open strings for lyrics annotations",
        "items": {
          "type": "string"
        }
      },
      "language": {
        "type": "string",
        "description": "Language tag conforming to IETF BCP 47 (RFC 5646)",
        "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z]{3})?(-[a-zA-Z]{4})?(-([a-zA-Z]{2}|[0-9]{3}))?(-([a-zA-Z0-9]{5,8}|[0-9][a-zA-Z0-9]{3}))*(-[a-wy-z0-9](-[a-zA-Z0-9]{2,8})+)*(-x(-[a-zA-Z0-9]{1,8})+)?$"
      }
    },
    "required": [
      "payload_type",
      "value",
      "language"
    ]
  },
  "payload/marker.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/marker.json",
    "title": "Marker Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "marker"
      },
      "description": {
        "type": "string"
      }
    },
    "required": [
      "payload_type",
      "description"
    ]
  },
  "payload/mood_thayer.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/mood_thayer.json",
    "title": "Mood_Thayer Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "mood_thayer"
      },
      "valence": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Valence",
        "items": {
          "type": "number"
        }
      },
      "arousal": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Arousal",
        "items": {
          "type": "number"
        }
      }
    },
    "required": [
      "payload_type",
      "valence",
      "arousal"
    ]
  },
  "payload/note.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/note.json",
    "title": "Note Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "note"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Musical notes in scientific pitch notation (e.g. C4, A4, C♯4, E♭3, F𝄪5, B𝄫2, D♮4, C-1)",
        "items": {
          "type": "string",
          "pattern": "^[A-G]([b♭]*|𝄫|[#♯]*|𝄪|♮)-?[0-9]+$"
        }
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payload/note_midi.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/note_midi.json",
    "title": "Note_Midi Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "note_midi"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Note pitches in (fractional) MIDI note numbers",
        "items": {
          "type": "number"
        }
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payload/object.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/object.json",
    "title": "Object Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "object"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Annotations consisting of structured object data",
        "items": {
          "type": "object"
        }
      },
      "description": {
        "type": "string",
        "description": "Optional human-readable description of the object payload"
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payload/relation.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/relation.json",
    "title": "Relation Payload",
    "description": "Columnar payload defining relationships between works (covers, quotes, etc).",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "relation"
      },
      "performance_id": {
        "type": "string"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "items": {
          "type": "string"
        },
        "description": "Array of referenced work or clique identifiers."
      },
      "relation": {
        "$ref": "../core.json#/$defs/Array",
        "items": {
          "type": "string",
          "enum": [
            "cover",
            "quote",
            "medley_part",
            "sample",
            "interpolation",
            "remix",
            "live_performance"
          ]
        },
        "description": "Array of relation types parallel to work_id."
      }
    },
    "required": [
      "payload_type",
      "performance_id",
      "value"
    ],
    "additionalProperties": false
  },
  "payload/tag.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/tag.json",
    "title": "Tag Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "tag"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Tag vocabularies allow all strings",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payload/tempo.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payload/tempo.json",
    "title": "Tempo Payload",
    "type": "object",
    "properties": {
      "payload_type": {
        "const": "tempo"
      },
      "value": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Tempo measurements, in beats per minute (BPM)",
        "items": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "required": [
      "payload_type",
      "value"
    ]
  },
  "payloads.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "payloads.json",
    "title": "Any Payload",
    "description": "A discriminated union of all supported columnar payload types.",
