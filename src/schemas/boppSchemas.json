  },
  "grouping.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "grouping.json",
    "title": "Grouping",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Name of the grouping layer"
      },
      "ids": {
