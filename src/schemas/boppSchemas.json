      "freq_min": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Array of minimum frequencies in Hz.",
        "items": {
          "type": "number",
          "minimum": 0
        }
      },
      "freq_max": {
        "$ref": "../core.json#/$defs/Array",
        "description": "Array of maximum frequencies in Hz.",
        "items": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "required": [
      "extent_type",
      "time",
      "duration",
      "freq_min",
      "freq_max"
    ]
  },
  "extent/time_interval.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
