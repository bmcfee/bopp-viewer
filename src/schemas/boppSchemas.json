    "properties": {
      "metadata_type": {
        "const": "algorithm"
      },
      "algorithm_id": {
        "type": "string",
        "description": "A unique identifier for the algorithm."
      },
      "version": {
        "type": "string",
        "description": "The version number of the algorithm."
      },
      "parameters": {
        "type": "object",
        "description": "A object containing the parameters used by the algorithm."
      }
    },
    "required": [
      "metadata_type",
      "algorithm_id",
      "version",
      "parameters"
    ]
  },
  "metadata/crowd.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "metadata/crowd.json",
    "title": "Crowd-sourced Annotation Metadata",
    "description": "Metadata for annotations created by crowdsourcing.",
    "type": "object",
    "properties": {
      "metadata_type": {
        "const": "crowd"
      },
      "platform": {
        "type": "string",
        "description": "The platform or service used for crowdsourcing the annotations."
      },
      "num_annotators": {
        "type": "integer",
        "description": "The number of annotators contributing to this annotation.",
        "minimum": 1
      },
      "consensus": {
        "type": "string",
        "description": "The method used to reach consensus among annotators (e.g., majority vote, expert review)."
      }
    },
    "required": [
      "metadata_type",
      "platform",
      "num_annotators",
      "consensus"
    ]
  },
  "metadata/derived.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "metadata/derived.json",
    "title": "Derived Annotation Metadata",
    "description": "Metadata describing an annotation produced by transforming or aggregating parent annotation(s).",
    "type": "object",
    "properties": {
      "metadata_type": {
        "const": "derived"
      },
      "transform": {
        "type": "string",
        "description": "The name or identifier of the operation/transform applied (e.g., 'trim', 'filter_by', 'to_times')."
      },
      "parameters": {
        "type": "object",
        "description": "Key-value mapping of parameters passed to the transform function."
      },
      "software": {
        "type": "string",
        "description": "Software name and/or version performing the derivation (e.g., 'bopp==1.0.0')."
      },
      "description": {
        "type": "string",
        "description": "Optional human-readable description or rationale for the derivation."
      }
    },
    "required": [
      "metadata_type",
      "transform"
    ]
  },
  "metadata/human.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "metadata/human.json",
    "title": "Human Annotation Metadata",
